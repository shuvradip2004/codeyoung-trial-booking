PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/codeyoung_trials
CLIENT_ORIGIN=http://localhost:5173

# Mentor working hours in the MENTOR'S local time (24h HH:mm)
MENTOR_WORK_START=09:00
MENTOR_WORK_END=23:00

# Optional SMTP. If SMTP_HOST is empty, emails are printed in the server console (dummy mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Codeyoung Trials <no-reply@codeyoung.demo>"
